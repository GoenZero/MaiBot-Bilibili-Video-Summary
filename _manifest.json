{
  "manifest_version": 2,
  "id": "com.goenzero.bilibili_video",
  "version": "0.2.0",
  "name": "B站 / Bilibili",
  "description": "让 AI 能看 B 站视频（短视频看画面和声音，长视频读字幕），也能扫码登录她自己的账号逛首页推荐、热门、搜索，看评论区（带图），点赞、投币、收藏、稍后再看、关注，看完留观看记录，把喜欢的评论图收藏成表情包。只看不评论；被风控就暂停等主人处理。",
  "author": {
    "name": "GoenZero",
    "url": "https://github.com/GoenZero"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary",
    "homepage": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary",
    "issues": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary/issues"
  },
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=7.4"
    }
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "tv"
    }
  },
  "capabilities": [
    "emoji.register",
    "llm.generate",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
