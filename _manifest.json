{
  "manifest_version": 2,
  "id": "com.goenzero.bilibili_video",
  "version": "0.1.0",
  "name": "B站视频 / Bilibili Video",
  "description": "让 AI 能看 B 站视频：短视频交给阿里百炼千问 Omni 或 Google Gemini 看画面和声音，长视频读字幕，并附上标题、简介和热门弹幕。",
  "author": {
    "name": "GoenZero",
    "url": "https://github.com/GoenZero"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary",
    "homepage": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary",
    "issues": "https://github.com/GoenZero/MaiBot-Bilibili-Video-Summary/issues"
  },
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9"
    }
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "tv"
    }
  },
  "capabilities": [
    "llm.generate",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
